# ---- 基础 ----
APP_NAME=针语 · AI 赋能湘绣文化数字化平台
ENV=dev
HOST=127.0.0.1
PORT=8130
LOG_LEVEL=INFO

# ---- 安全（生产环境务必改）----
SECRET_KEY=zhenyu-dev-secret-change-me
ACCESS_TOKEN_TTL_MIN=10080

# ---- 存储 ----
# 默认 SQLite；如需 Postgres 改为 postgresql+psycopg://user:pwd@host:5432/zhenyu
DB_URL=sqlite:///./data/zhenyu.db

# ---- 图像生成 ----
# mock = 本地程序化渲染（零密钥可跑）；api = 调用 OpenAI 兼容文生图接口
IMAGE_PROVIDER=mock
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=sd-xl
IMAGE_SIZE=640
MOCK_RENDER_STROKES=5200
IMAGE_COST_PER_CALL=0.35
DAILY_BUDGET_LIMIT=200

# ---- 合规标识 ----
AI_VISIBLE_LABEL=AI 效果示意 · 非实物绣品
AI_PROVIDER_CODE=ZHENYU-MVP-001

# ---- 检索 ----
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.15

# ---- 限流 ----
RATE_LIMIT_GENERATE_PER_HOUR=30
